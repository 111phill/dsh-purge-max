{
  "name": "dsh-purge-community",
  "version": "1.6.19",
  "description": "Purge Community：独立维护的 DSH 插件，原生设置、宿主诊断、独立更新检查与安装、本机备份和回滚。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json",
    "./presets-plugin": "./lib/presets-plugin.js"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js",
    "purge-community": "bin/community.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE.md",
    "CONTRIBUTORS.md",
    "AGENTS.md"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node packages/purge-panel/scripts/build.mjs --community",
    "test": "node --test test/install-registry.test.mjs test/bootstrap-install.test.mjs test/community.test.mjs test/patch-anchors.test.mjs test/selfcheck.test.mjs test/asar-swap-fallback.test.mjs test/windows-electron-handoff.test.mjs test/settings-api.test.mjs test/host-backup.test.mjs test/atomic-files.test.mjs test/host-layout.test.mjs test/runtime-layout.test.mjs test/boost.test.mjs test/prompt-sections.test.mjs test/presets.test.mjs test/preset-compat.test.mjs test/anchors.test.mjs test/audit.test.mjs test/instance.test.mjs test/update-policy.test.mjs test/market.test.mjs test/command-registration.test.mjs test/plugin-lifecycle.test.mjs test/permission-state.test.mjs",
    "test:ui": "node packages/purge-panel/test/community.cjs",
    "check:client": "node packages/purge-panel/scripts/build.mjs --community --check",
    "diagnose": "node bin/community.js diagnose",
    "check:docs": "node scripts/check-docs.mjs",
    "smoke": "npm pack --ignore-scripts && node scripts/smoke.mjs",
    "test:electron": "node scripts/check-electron-selfcheck.mjs",
    "build:market": "node scripts/build-market.mjs"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "purge-community",
    "prompt-management",
    "rules",
    "agent",
    "backup",
    "rollback",
    "compatibility"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingcharleslzy-ai/dsh-purge.git"
  },
  "homepage": "https://github.com/kingcharleslzy-ai/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/kingcharleslzy-ai/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/kingcharleslzy-ai/dsh-purge/releases/latest/download/dsh-purge-community-1.6.19.tgz",
      "git": "https://github.com/kingcharleslzy-ai/dsh-purge.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.1 (runtime injection + host patches verified)",
  "contributors": [
    "小杨 / YuJunZhiXue (original dsh-purge author)",
    {
      "name": "luowang-ui",
      "url": "https://github.com/luowang-ui"
    },
    {
      "name": "heigit",
      "url": "https://github.com/heigit"
    },
    {
      "name": "OGHong",
      "url": "https://github.com/OGHong"
    }
  ],
  "author": {
    "name": "kingcharleslzy-ai",
    "url": "https://github.com/kingcharleslzy-ai"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5"
  }
}
